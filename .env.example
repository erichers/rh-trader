# ──────────────────────────────────────────────────────────────────────────
# rh.tradingbot — local config. Copy to `.env` and fill in. NEVER commit .env.
# ──────────────────────────────────────────────────────────────────────────

# ── Claude (optional last rung). Hidden from chips/probes unless live. ───────
# A 401 key is parked: no 6h re-probe, no cascade, no strip lamp.
# To force it back on after you have a working key: ANTHROPIC_ENABLE=1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# effort: low | medium | high | xhigh | max  (xhigh recommended for agentic work)
ANTHROPIC_EFFORT=high
# ANTHROPIC_ENABLE=1

# ── Robinhood Agentic MCP ───────────────────────────────────────────────────
# The backend connects as an MCP client over OAuth (one-time browser auth).
RH_MCP_URL=https://agent.robinhood.com/mcp/trading
# Where backend persists the RH OAuth tokens (gitignored).
RH_TOKEN_STORE=./backend/data/oauth-tokens.json
# Local port the backend opens to catch the OAuth redirect during first auth.
RH_OAUTH_CALLBACK_PORT=7321

# ── MAMP MySQL ──────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=rh_tradingbot
# Ulric local import: DB_NAME=ulric_rhtrader

# ── Server ──────────────────────────────────────────────────────────────────
# Backend listens here; MAMP Apache proxies http://localhost:8888/rh.tradingbot/ to it.
PORT=8011
BASE_PATH=/rh.tradingbot

# ── Trading safety ──────────────────────────────────────────────────────────
# Global execution mode: observe | cautious | auto | full_auto
#   observe   = log what would happen, place NO real orders
#   cautious  = stage every order for one-click approval
#   auto      = bots auto-execute when rules + risk engine pass
#   full_auto = auto + Claude may open new positions on its own within guardrails
DEFAULT_MODE=observe
# Master kill switch. true = block ALL order placement regardless of mode.
KILL_SWITCH=false

# ── Hard guardrails (deterministic risk engine) ─────────────────────────────
# Allowed asset classes. Crypto is intentionally absent and hard-blocked.
ALLOWED_ASSET_CLASSES=equity,etf,option
MAX_POSITION_USD=2000
MAX_PORTFOLIO_CONCENTRATION_PCT=25
MAX_DAILY_LOSS_PCT=3
MAX_ORDERS_PER_DAY=40

# ── AI providers ────────────────────────────────────────────────────────────
# Model ids and the per-task fallback chains live in ONE file: backend/src/ai/models.ts.
# The *_MODEL vars below are OPTIONAL: each one overrides that provider's default pick.
# Every provider's /models endpoint is probed at boot and every 6h, and a retired id
# walks that provider's ladder (Groq retired all llama-3.x chat models in Aug 2026).
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
# NVIDIA NIM (OpenAI-compatible): extra fallback capacity + embeddings for RAG.
# Without a key the NIM chain entries and embedTexts() are simply skipped.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
# Meta Model API — Muse Spark (OpenAI-compatible Chat Completions).
# Docs: https://ai.developer.meta.com/docs/models/  Dashboard: https://ai.developer.meta.com/
# Base https://api.meta.ai/v1, Bearer auth. GET /v1/models is probed at boot like Groq/NVIDIA.
# Key aliases (first non-empty wins): META_MUSE_API_KEY, MUSE_API_KEY, MODEL_API_KEY (Meta's official name).
# Model aliases: META_MUSE_MODEL, MUSE_MODEL. Leave empty: live PAYG Standard id is muse-spark-1.3.
# Leads Ask AI chat, watch, performance, and agent. Chat completions on that id return HTTP 200.
# Do not set contributor as the default. Never commit a real key.
META_MUSE_API_KEY=
META_MUSE_BASE_URL=https://api.meta.ai/v1
META_MUSE_MODEL=

# Observe-only watcher. Comma list of tickers Muse watches for news + simple indicators.
# Default is the paper-desk universe. The watcher writes alerts and notes; it never places orders.
WATCH_UNIVERSE=SPY,META,TSLA,QQQ
# Optional override of the watch-loop interval in milliseconds (default 15 minutes).
# WATCH_INTERVAL_MS=900000

# Disaster drill: comma list of providers that must throw on every call, so the
# fallback path can be proven without editing code. Leave EMPTY in normal use.
# Example: LLM_POISON_PROVIDERS=groq,kimi
LLM_POISON_PROVIDERS=

# ── Local / self-hosted model (any OpenAI-compatible server). Last fallback rung. ──
# Unset = hidden from chips and probes. Set both URL + model to bring it back.
# Ollama: LOCAL_BASE_URL=http://localhost:11434/v1  LOCAL_MODEL=llama3.1:8b (key optional)
# LM Studio: LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_BASE_URL=
LOCAL_MODEL=
LOCAL_API_KEY=

# ── Alpaca (paper trading by default; also ALL market data, bars and option chains) ──
# Keys: https://app.alpaca.markets  ->  Paper Trading  ->  API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets/v2
ALPACA_DATA_URL=https://data.alpaca.markets/v2
# Trading environment at first boot: alpaca_paper (default) | robinhood_live (switchable in the app, confirm required)
TRADING_ENV=alpaca_paper
