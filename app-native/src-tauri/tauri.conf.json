{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rh.tradingbot",
  "version": "0.1.0",
  "identifier": "com.ulrich.rhtradingbot",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "rh.tradingbot",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "url": "http://127.0.0.1:8011/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
